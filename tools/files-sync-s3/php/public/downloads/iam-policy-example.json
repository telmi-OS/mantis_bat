{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDataBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET"
    },
    {
      "Sid": "ReadAndWriteSyncedObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET/synced-files/*",
        "arn:aws:s3:::YOUR_BUCKET/_telmi_sync/state.json",
        "arn:aws:s3:::YOUR_BUCKET/_telmi_sync/conflicts/*",
        "arn:aws:s3:::YOUR_BUCKET/_telmi_sync/deleted/*"
      ]
    },
    {
      "Sid": "DeleteSyncedObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET/synced-files/*"
    },
    {
      "Sid": "ReadGhostJwt",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "YOUR_SECRET_ARN"
    }
  ]
}
